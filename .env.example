# Copy to .env (git-ignored) and fill in. Never commit real values.
# Azure AI Foundry resource endpoint. Either form works:
#   https://<resource>.services.ai.azure.com
#   https://<resource>.openai.azure.com/openai/v1/
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
# Chat model deployment used as the relevance judge (e.g. a gpt-4.1-mini deployment name).
AZURE_JUDGE_DEPLOYMENT=
# Optional: embeddings deployment for `--encoder azure` (e.g. text-embedding-3-small).
AZURE_EMBED_DEPLOYMENT=

# Optional: where raw downloads and judge caches live. Default ~/.cache/student-job-match-bench
# SJMB_CACHE_DIR=
